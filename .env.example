HOST=127.0.0.1
PORT=8000
DAOLOOK_MODE=demo
DAOLOOK_DB=data/daolook.db
# Daily public recommendation sync uses this calendar timezone.
DAOLOOK_FEED_TIMEZONE=America/New_York
# First-run bootstrap only: existing administrator passwords are never overwritten.
DAOLOOK_ADMIN_EMAIL=admin@example.com
DAOLOOK_ADMIN_PASSWORD=replace-with-a-strong-password
# Set to 1 behind HTTPS in production.
DAOLOOK_SECURE_COOKIE=0

# Live paid requests fail closed until conservative provider price ceilings are configured.
# Integer micro-USD; 1000000 = USD 1. See docs/2026-10-23-工程审查修复.md.
DAOLOOK_EXTERNAL_PRICES={}
DAOLOOK_USER_DAILY_BUDGET_MICROUSD=2000000
DAOLOOK_DAILY_BUDGET_MICROUSD=20000000
DAOLOOK_SIGNUP_DAILY_CREDITS=1000
DAOLOOK_SIGNUP_TOTAL_CREDITS=10000
# Optional private mounted credential directory (default: DB parent/secrets).
# DAOLOOK_SECRETS_DIR=/private/daolook-secrets
DAOLOOK_USER_STORAGE_BYTES=104857600
DAOLOOK_TOTAL_STORAGE_BYTES=1073741824
DAOLOOK_MIN_FREE_BYTES=134217728
