{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "xhs creation batch",
  "type": "object",
  "required": ["outputs"],
  "properties": {
    "outputs": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "title",
          "cover_text",
          "body",
          "titles",
          "tags",
          "image_suggestions",
          "storyboard",
          "shooting_list",
          "missing",
          "hook"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "cover_text": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string",
            "minLength": 1
          },
          "titles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "image_suggestions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "storyboard": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "shooting_list": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "missing": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hook": {
            "type": "string"
          }
        }
      }
    }
  }
}
