{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "douyin creation batch",
  "type": "object",
  "required": [
    "outputs"
  ],
  "description": "一次 6 到 8 条。资料够用时两种方向都要出现；只够一个方向时整批同方向、各条切角不同，并在 missing 写明另一方向缺哪项事实。",
  "properties": {
    "outputs": {
      "type": "array",
      "minItems": 6,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "direction",
          "role",
          "angle",
          "title",
          "cover_text",
          "body",
          "titles",
          "tags",
          "image_suggestions",
          "storyboard",
          "shooting_list",
          "missing",
          "hook",
          "audience",
          "value",
          "cta",
          "evidence"
        ],
        "properties": {
          "direction": {
            "type": "string",
            "enum": [
              "建立信任",
              "截流"
            ],
            "description": "这条内容的岗位类型，先定方向再写表达"
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "description": "这篇在账号里承担的岗位，一句话"
          },
          "angle": {
            "type": "string",
            "minLength": 1,
            "description": "切角；同一方向下各条不得相同"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "cover_text": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string",
            "minLength": 1
          },
          "titles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "image_suggestions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "storyboard": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "shooting_list": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "missing": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hook": {
            "type": "string",
            "minLength": 1
          },
          "audience": {
            "type": "string",
            "description": "具体目标人群"
          },
          "value": {
            "type": "string",
            "description": "读者的具体收获"
          },
          "cta": {
            "type": "string",
            "description": "与正文结尾一致的一句行动引导"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "asset_id",
                "quote"
              ],
              "properties": {
                "asset_id": {
                  "type": "string"
                },
                "quote": {
                  "type": "string",
                  "minLength": 4
                }
              }
            },
            "description": "仅引用本次用户文字资料的原文；无法引用时空数组并记录缺项"
          }
        }
      }
    }
  }
}
